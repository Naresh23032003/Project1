{
  "name": "offer-decoder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "chmod +x .githooks/* 2>/dev/null; git config core.hooksPath .githooks || true; node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "check:text": "node scripts/check-staged.mjs --all",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@vercel/analytics": "^2.0.1",
    "mammoth": "^1.13.0",
    "next": "^16.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jszip": "^3.10.2",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
